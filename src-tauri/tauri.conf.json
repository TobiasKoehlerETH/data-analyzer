{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Data Analyzer",
  "version": "1.0.0",
  "identifier": "com.angstpfister.data-analyzer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Data Analyzer",
        "width": 1600,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Industrial time-series data analyzer",
    "category": "Utility"
  }
}
